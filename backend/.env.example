# ---------------------------------------------------------------------------
# Copiar a .env y rellenar. El .env real no se versiona.
# ---------------------------------------------------------------------------

# Usuario maestro. Solo lo usa db/migrar.mjs para aplicar migraciones.
# La aplicacion nunca se conecta con este usuario.
DATABASE_URL=postgres://USUARIO:CLAVE@HOST:5432/educa

# Trafico de negocio: sujeto a RLS, exige contexto de usuario e institucion.
DATABASE_URL_APP=postgres://educa_app:CLAVE@HOST:5432/educa

# Solo el modulo de autenticacion: login, registro, refresco, invitaciones.
DATABASE_URL_AUTH=postgres://educa_auth:CLAVE@HOST:5432/educa

# Los dos roles se crean en la migracion 0001 sin contrasena. Asignarlas con el
# usuario maestro antes de arrancar la API:
#   alter role educa_app  with password '...';
#   alter role educa_auth with password '...';

# Firma de los access token. Cambiarlo invalida todas las sesiones abiertas.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=
JWT_MINUTOS=15
REFRESCO_DIAS=30

PORT=3000
ORIGEN_WEB=http://localhost:5173

# ---------------------------------------------------------------------------
# Produccion (Vercel). Estas se cargan en el panel del proyecto, no en .env.
# ---------------------------------------------------------------------------

# En Vercel el frontend y la API viven en el mismo dominio (vercel.json enruta
# /api al servicio backend), asi que CORS no llega a intervenir. Se pone igual
# por si algun cliente externo consume la API desde otro origen.
# ORIGEN_WEB=https://TU-PROYECTO.vercel.app

# Conexiones por pool. Hay dos pools (negocio e identidad) por cada instancia
# de la funcion, y RDS esta compartido: subirlo sin mirar agota el cupo.
# PG_POOL_MAX=5

# PORT lo inyecta Vercel: no definirlo a mano en produccion.
# Envío de certificados por correo (opcional; impresión funciona sin esto)
RESEND_API_KEY=
CORREO_REMITENTE=certificados@tu-dominio.com

# ---------------------------------------------------------------------------
# Clases en vivo (Jitsi Meet)
# ---------------------------------------------------------------------------

# Servidor de Jitsi. Sin tocar nada usa el publico meet.jit.si, que sirve para
# probar: no admite tokens y la sala la protege solo su nombre aleatorio.
JITSI_DOMINIO=meet.jit.si

# Para clases reales, despliega Jitsi Meet -es software libre- con el modulo de
# tokens de Prosody y rellena estas dos. Entonces la entrada la firma el backend
# sala por sala, y quien no traiga token no pasa. Deben coincidir con
# app_id / app_secret del prosody.cfg.lua del servidor.
#   Generar el secreto: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JITSI_APP_ID=dr360training
JITSI_APP_SECRETO=

# Cuanto vale el token de entrada. Cubre la clase entera mas margen: si expira
# a media reunion, a quien se le corte la conexion no puede volver a entrar.
JITSI_TOKEN_MINUTOS=240
